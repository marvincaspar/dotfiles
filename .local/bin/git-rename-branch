#!/usr/bin/env bash
# git-rename-branch — rename local and remote branch
#
# Usage:
#   git-rename-branch <old-branch> <new-branch>
set -euo pipefail

main() {
  command -v git >/dev/null 2>&1 || { echo "git-rename-branch: git is required" >&2; exit 1; }
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "git-rename-branch: not inside a git repository" >&2; exit 1; }

  if [ "$#" -ne 2 ]; then
      echo "Usage: $0 <old-branch> <new-branch>" >&2
      exit 1
  fi

  old_name=$1
  new_name=$2
  remote=origin

  # Rename the local branch to the new name
  git branch -m "$old_name" "$new_name"

  # Delete the old branch on remote
  git push "$remote" --delete "$old_name"

  # Prevent git from using the old name when pushing in the next step.
  # Otherwise, git will use the old upstream name instead of $new_name.
  git branch --unset-upstream "$new_name"

  # Push the new branch and set its upstream
  git push "$remote" -u "$new_name"
}

main "$@"
