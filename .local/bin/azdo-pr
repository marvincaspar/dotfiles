#!/usr/bin/env bash
# azdo-pr — create or open Azure DevOps pull request
#
# Usage:
#   azdo-pr [title]
set -euo pipefail

fail() {
  echo "Error: $*" >&2
  exit 1
}

open_url() {
  local url="$1"

  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  else
    echo "Open this URL in your browser: $url"
  fi
}

parse_remote() {
  local remote_url="$1"

  if [[ "$remote_url" =~ ^https://dev\.azure\.com/([^/]+)/([^/]+)/_git/([^/]+)$ ]]; then
    organization="${BASH_REMATCH[1]}"
    project="${BASH_REMATCH[2]}"
    repository="${BASH_REMATCH[3]}"
    return 0
  fi

  if [[ "$remote_url" =~ ^https://[^@]+@dev\.azure\.com/([^/]+)/([^/]+)/_git/([^/]+)$ ]]; then
    organization="${BASH_REMATCH[1]}"
    project="${BASH_REMATCH[2]}"
    repository="${BASH_REMATCH[3]}"
    return 0
  fi

  if [[ "$remote_url" =~ ^https://([^.]+)\.visualstudio\.com/([^/]+)/_git/([^/]+)$ ]]; then
    organization="${BASH_REMATCH[1]}"
    project="${BASH_REMATCH[2]}"
    repository="${BASH_REMATCH[3]}"
    return 0
  fi

  fail "unsupported remote URL: $remote_url\nExpected an Azure DevOps HTTPS remote like https://dev.azure.com/<org>/<project>/_git/<repo>"
}

find_target_branch() {
  if git show-ref --verify --quiet refs/remotes/${remote_name}/main || git show-ref --verify --quiet refs/heads/main; then
    echo "main"
    return 0
  fi

  if git show-ref --verify --quiet refs/remotes/${remote_name}/master || git show-ref --verify --quiet refs/heads/master; then
    echo "master"
    return 0
  fi

  fail "could not find main or master"
}

main() {
  remote_name="${AZURE_PR_REMOTE:-origin}"
  command -v git >/dev/null 2>&1 || fail "git is required"
  command -v az >/dev/null 2>&1 || fail "Azure CLI is required"

  current_branch="$(git branch --show-current)"
  [[ -n "$current_branch" ]] || fail "not on a branch"

  if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
    echo "Nothing to do on $current_branch"
    exit 0
  fi

  remote_url="$(git remote get-url "$remote_name" 2>/dev/null)" || fail "could not read remote '$remote_name'"
  organization=""
  project=""
  repository=""
  parse_remote "$remote_url"
  project="$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$project")"
  repository="$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$repository")"

  organization_url="https://dev.azure.com/${organization}"
  target_branch="$(find_target_branch)"
  source_ref="refs/heads/${current_branch}"
  target_ref="refs/heads/${target_branch}"

  title="${*:-$(git log -1 --pretty=%s)}"

  if ! git ls-remote --exit-code --heads "$remote_name" "$current_branch" >/dev/null 2>&1; then
    echo "Pushing ${current_branch} to ${remote_name}..."
    git push -u "$remote_name" "$current_branch"
  fi

  existing_pr_id="$({
    az repos pr list \
      --organization "$organization_url" \
      --project "$project" \
      --repository "$repository" \
      --status active \
      --source-branch "$source_ref" \
      --query '[0].pullRequestId' \
      --output tsv
  } 2>/dev/null || true)"

  if [[ -n "$existing_pr_id" && "$existing_pr_id" != "null" ]]; then
    repo_web_url="$(az repos show --organization "$organization_url" --project "$project" --repository "$repository" --query webUrl --output tsv)"
    pr_url="${repo_web_url}/pullrequest/${existing_pr_id}"
    echo "PR already exists: ${pr_url}"
    open_url "$pr_url"
    exit 0
  fi

  echo "Creating PR for ${current_branch} -> ${target_branch}..."
  pr_id="$(az repos pr create \
    --organization "$organization_url" \
    --project "$project" \
    --repository "$repository" \
    --source-branch "$source_ref" \
    --target-branch "$target_ref" \
    --title "$title" \
    --query pullRequestId \
    --delete-source-branch \
    --output tsv)"

  repo_web_url="$(az repos show --organization "$organization_url" --project "$project" --repository "$repository" --query webUrl --output tsv)"
  pr_url="${repo_web_url}/pullrequest/${pr_id}"

  echo "Created PR: ${pr_url}"
  open_url "$pr_url"
}

main "$@"
