[user]
  email = marvin.caspar@gmail.com
  name = Marvin Caspar
  signingkey = ~/.ssh/git_signing_key.pub
[core]
  autocrlf = input
  editor = vim
  excludesfile = ~/.gitignore_global
  # hooksPath = ~/.git-hooks
  pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    line-numbers = true
    side-by-side = true
[merge]
    conflictStyle = zdiff3
[alias]
  a = add
  aa = add .
  st = status
  ci = commit
  cim = commit -m
  br = branch
  co = checkout
  sw = switch
  df = difftool
  mg = mergetool
  rb = rebase
  rbd = rebase -i develop
  pf = push --force-with-lease
  po = push origin
  pot = push origin --tags
  por = push origin master develop --tags

  update = !git-update
  nuke = !git-nuke

  lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d    %C(reset)' --all
  lga = log --graph --oneline --all --decorate

  append = commit --amend --no-edit
  undo = reset --hard HEAD
  undoc = reset --hard HEAD~1

  # git duet
  dci = duet-commit
  drv = duet-revert
  dmg = duet-merge
  drb = rebase -i --exec 'git duet-commit --amend'

[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = green
  changed = yellow
  untracked = cyan
[push]
  default = simple
  autoSetupRemote = true
[pull]
  rebase = true
[credential]
  helper = osxkeychain
  credentialStore = cache
  azreposCredentialType = oauth
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[init]
  defaultBranch = main
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
  # https://javorszky.co.uk/2023/11/21/sign-my-git/
  # touch ~/.ssh/allowed_signers && echo "$(git config --get user.email) namespaces=\"git\" $(cat ~/.ssh/id_ed25519.pub)" >> ~/.ssh/allowed_signers
  allowedSignersFile = ~/.ssh/allowed_signers
[rerere]
  enabled = 1
  autoupdate = 1
[credential "https://dev.azure.com"]
  useHttpPath = true
